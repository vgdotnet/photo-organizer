<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PhotoOrganizer.Controls.TreeIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="FolderBody" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FFD97A" />
            <GradientStop Offset="1" Color="#F2BD45" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TabGold" Color="#F2BD45" />
        <SolidColorBrush x:Key="DriveBody" Color="#CFCFCF" />
    </UserControl.Resources>

    <Grid Width="15" Height="14">
        <Rectangle x:Name="Tab" Width="6" Height="3" RadiusX="1" RadiusY="1"
                   Fill="{StaticResource TabGold}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" />
        <Rectangle x:Name="Body" Width="15" Height="11" RadiusX="2" RadiusY="2"
                   VerticalAlignment="Bottom" Fill="{StaticResource FolderBody}" />
    </Grid>
</UserControl>
