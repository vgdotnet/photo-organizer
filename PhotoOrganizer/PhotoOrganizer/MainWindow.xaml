<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PhotoOrganizer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoOrganizer"
    xmlns:controls="using:PhotoOrganizer.Controls"
    xmlns:vm="using:PhotoOrganizer.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#F3F3F3">
        <Grid.Resources>
            <SolidColorBrush x:Key="Bg" Color="#F3F3F3" />
            <SolidColorBrush x:Key="Panel" Color="#F7F7F7" />
            <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Stroke" Color="#E3E3E3" />
            <SolidColorBrush x:Key="Stroke2" Color="#CFCFCF" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5F5F5F" />
            <SolidColorBrush x:Key="TextTertiary" Color="#8F8F8F" />
            <SolidColorBrush x:Key="Accent" Color="#005FB8" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E6F0FA" />
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Hover" Color="#ECECEC" />
            <SolidColorBrush x:Key="Sel" Color="#DFEEFB" />
            <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
            <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DangerBg" Color="#FDF3F2" />
            <SolidColorBrush x:Key="DangerStroke" Color="#EFC4BF" />
            <SolidColorBrush x:Key="Keep" Color="#0F7B0F" />
            <SolidColorBrush x:Key="KeepBg" Color="#E9F4E9" />
            <SolidColorBrush x:Key="Folder" Color="#F2BD45" />

            <LinearGradientBrush x:Key="ThumbA" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#8FA8BF" />
                <GradientStop Offset="1" Color="#C4D2DE" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ThumbB" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#A3B18A" />
                <GradientStop Offset="1" Color="#D3DBC0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ThumbC" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#C2A38A" />
                <GradientStop Offset="1" Color="#E4D3C0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ThumbD" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#9A8FB8" />
                <GradientStop Offset="1" Color="#CFC7E0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ThumbE" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#7F9C96" />
                <GradientStop Offset="1" Color="#BCD2CC" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ThumbF" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#B08F9A" />
                <GradientStop Offset="1" Color="#DCC4CC" />
            </LinearGradientBrush>

            <x:String x:Key="GlyphDown">&#xE70D;</x:String>
            <x:String x:Key="GlyphRight">&#xE76C;</x:String>

            <Style x:Key="TileItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Height="56" Padding="12,0"
                Background="{StaticResource Panel}"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource Stroke}">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Scan" Height="32" Padding="14,0"
                            Background="{StaticResource Accent}" Foreground="{StaticResource OnAccent}"
                            BorderBrush="{StaticResource Accent}" FontWeight="SemiBold" />
                    <Button Content="Find duplicates" Height="32" Padding="14,0"
                            Background="{StaticResource Card}" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Stroke}" />
                    <Button Content="Organize" Height="32" Padding="14,0"
                            Background="{StaticResource Card}" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Stroke}" />
                    <Button Height="32" Padding="14,0"
                            Background="{StaticResource Card}" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Stroke}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Review deletions" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Danger}" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center">
                                <TextBlock Text="12" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnDanger}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{StaticResource Stroke}" Margin="4,0" />
                    <Button Content="Settings" Height="32" Padding="14,0"
                            Background="{StaticResource Card}" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Stroke}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Scan complete — 4,312 files indexed"
                               FontSize="12" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="386 duplicates · 12 marked for deletion · 1,204 unique to copy"
                               FontSize="11" HorizontalAlignment="Right"
                               Foreground="{StaticResource TextTertiary}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{StaticResource Panel}"
                  BorderThickness="0,0,1,0" BorderBrush="{StaticResource Stroke}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="56*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Padding="14,10,14,6" VerticalAlignment="Bottom">
                        <TextBlock Text="DESTINATION" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.DestinationHint, Mode=OneWay}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TreeView Grid.Row="1" Padding="4,0,4,8"
                              ItemsSource="{x:Bind ViewModel.DestinationTree, Mode=OneWay}"
                              SelectionMode="Single"
                              Expanding="DestinationTree_Expanding"
                              ItemInvoked="DestinationTree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}"
                                              HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <controls:TreeIcon IsDrive="{x:Bind IsDrive}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <Border Grid.Row="1" Height="8" Background="{StaticResource Bg}"
                        BorderThickness="0,1" BorderBrush="{StaticResource Stroke}">
                    <Rectangle Width="28" Height="3" RadiusX="2" RadiusY="2"
                               Fill="{StaticResource Stroke2}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                Padding="14,10,14,6" VerticalAlignment="Bottom">
                        <TextBlock Text="SOURCES" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" />
                        <TextBlock Text="check folders to scan" FontSize="11"
                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Padding="6,0,6,8">
                        <StackPanel>
                            <CheckBox IsChecked="{x:Null}" IsThreeState="True" MinWidth="0" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon IsDrive="True" />
                                    <TextBlock Text="External (E:)" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="True" MinWidth="0" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="Camera Uploads" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="True" MinWidth="0" Margin="48,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="2022" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="True" MinWidth="0" Margin="48,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="2023" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="True" MinWidth="0" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="Old Laptop Backup" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="False" MinWidth="0" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="Downloads" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Null}" IsThreeState="True" MinWidth="0" Margin="4,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon IsDrive="True" />
                                    <TextBlock Text="Local Disk (C:)" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{x:Null}" IsThreeState="True" MinWidth="0" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="Users › Anna" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="True" MinWidth="0" Margin="48,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="Pictures" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="False" MinWidth="0" Margin="48,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:TreeIcon />
                                    <TextBlock Text="OneDrive Camera Roll" FontSize="13" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Background="{StaticResource Bg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="42" Padding="16,0"
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource Stroke}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="External (E:) › Camera Uploads › " FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="2023" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="24 items" FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
                    </Grid>
                </Border>

                <GridView Grid.Row="1" Padding="16,14"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource TileItemStyle}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="178" ItemHeight="192" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbA}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="IMG_2034.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="4.2 MB · Jul 15, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource KeepBg}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Keep" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Keep}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1.5" BorderBrush="{StaticResource Danger}">
                            <StackPanel>
                                <Grid Height="100">
                                    <Rectangle Fill="{StaticResource ThumbA}" Opacity="0.7" />
                                    <Border Width="18" Height="18" CornerRadius="3" Margin="6"
                                            Background="{StaticResource Danger}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                                  FontSize="12" Foreground="{StaticResource OnDanger}" />
                                    </Border>
                                </Grid>
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="IMG_2034 (1).jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="4.2 MB · Jul 15, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource DangerBg}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left"
                                            BorderThickness="1" BorderBrush="{StaticResource DangerStroke}">
                                        <TextBlock Text="Marked for deletion" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Danger}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbB}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="DSC_0141.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="6.8 MB · May 2, 2022" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource Hover}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Duplicate" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbD}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="PXL_20230811_174233.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="3.1 MB · Aug 11, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbE}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="20230715_183012.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="2.9 MB · Jul 15, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Already in archive" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbC}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="IMG_2101.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="3.8 MB · Jul 18, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbF}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="IMG_2102.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="4.0 MB · Jul 18, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1.5" BorderBrush="{StaticResource Danger}">
                            <StackPanel>
                                <Grid Height="100">
                                    <Rectangle Fill="{StaticResource ThumbB}" Opacity="0.7" />
                                    <Border Width="18" Height="18" CornerRadius="3" Margin="6"
                                            Background="{StaticResource Danger}"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE73E;" FontFamily="Segoe Fluent Icons"
                                                  FontSize="12" Foreground="{StaticResource OnDanger}" />
                                    </Border>
                                </Grid>
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="DSC_0198.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="5.4 MB · May 3, 2022" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource DangerBg}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left"
                                            BorderThickness="1" BorderBrush="{StaticResource DangerStroke}">
                                        <TextBlock Text="Marked for deletion" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Danger}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Width="166" Height="180" CornerRadius="6" Background="{StaticResource Card}"
                                BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                            <StackPanel>
                                <Rectangle Height="100" Fill="{StaticResource ThumbA}" />
                                <StackPanel Padding="10,8,10,10" Spacing="4">
                                    <TextBlock Text="20230704_210455.jpg" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="2.4 MB · Jul 4, 2023" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}" />
                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="3"
                                            Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="Already in archive" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Accent}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                </GridView>

                <Border Grid.Row="2" Height="30" Padding="16,0"
                        Background="{StaticResource Panel}"
                        BorderThickness="0,1,0,0" BorderBrush="{StaticResource Stroke}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="24 items · 14 unique · 4 duplicates · 3 in archive · 3 marked in this folder"
                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,16,0" Foreground="{StaticResource TextSecondary}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Keep}" VerticalAlignment="Center" />
                                <TextBlock Text="Keep" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Stroke2}" VerticalAlignment="Center" />
                                <TextBlock Text="Duplicate" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="In archive" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Rectangle Width="8" Height="8" RadiusX="2" RadiusY="2" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Text="Marked for deletion" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
